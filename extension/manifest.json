{
  "manifest_version": 3,
  "name": "qwerf — Yandex.Music sync",
  "short_name": "qwerf",
  "version": "0.2.0",
  "description": "Search Yandex.Music and download tracks straight to your local lossless library via the qwerf listener.",
  "action": {
    "default_title": "qwerf",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
